{
 "select": [
  "c.id",
  "c.name"
 ],
 "from": "customers",
 "as": "c",
 "where": [
  {
   "op": "not_in",
   "args": [
    {
     "col": "c.referrer"
    }
   ],
   "query": {
    "from": "blacklist",
    "as": "b",
    "select": [
     "b.customer_id"
    ],
    "where": [
     {
      "op": "is_not_null",
      "arg": {
       "col": "b.customer_id"
      }
     }
    ]
   }
  }
 ]
}